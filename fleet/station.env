# fleet/station.env — per-workstation config. Sourced by nightly.sh / postrun.sh / install_cron.sh.
# On a new machine you normally only edit STATION, REPO, and the window;
# APP_DIR / DATA_DIR auto-derive from this file's location.

# --- identity (unique per workstation: st01, st02, ...) ---
STATION=st01

# --- paths ---
APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"   # repo root = parent of fleet/ (auto)
DATA_DIR="$APP_DIR/data"                                     # recordings staging (auto)
REPO=/CHANGE/ME/douyin                                       # <-- the ModelScope dataset clone (set this)
BRANCH=master                                                # ModelScope UI only renders master

# --- nightly window ---
START_AT=20:00        # HH:MM local time to begin
MINUTES=120           # window length in minutes (120 = 2h)

# --- packing ---
SHARD_GB=7            # max video shard size (keep <= 7)

# --- safety ---
DISK_FLOOR_GB=40      # abort start / warn if free space below this
